--- a/ml_dtypes/include/float8.h
+++ b/ml_dtypes/include/float8.h
@@ -1410,12 +1410,21 @@
     const FromBits from_bits =
         Eigen::numext::bit_cast<FromBits>(Eigen::numext::abs(from));
 
     // Special values, preserving sign.
-    if (Eigen::numext::isinf(from)) {
+    // ROCm device linking cannot resolve Eigen's float isinf/isnan wrappers.
+    // IEEE float32 classifications are exact when checked using exponent bits.
+    bool from_isinf;
+    bool from_isnan;
+    if constexpr (std::is_same_v<From, float>) {
+      const FromBits magnitude = Eigen::numext::bit_cast<FromBits>(from) &
+                                 static_cast<FromBits>(0x7fffffffU);
+      from_isinf = magnitude == static_cast<FromBits>(0x7f800000U);
+      from_isnan = magnitude > static_cast<FromBits>(0x7f800000U);
+    } else {
+      from_isinf = Eigen::numext::isinf(from);
+      from_isnan = Eigen::numext::isnan(from);
+    }
+    if (from_isinf) {
       return from_sign_bit ? -Eigen::NumTraits<To>::infinity()
                            : Eigen::NumTraits<To>::infinity();
     }
-    if (Eigen::numext::isnan(from)) {
+    if (from_isnan) {
       return from_sign_bit ? -Eigen::NumTraits<To>::quiet_NaN()
                            : Eigen::NumTraits<To>::quiet_NaN();
     }
